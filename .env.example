# Copy to .env on the VPS and fill in. Never commit .env.

# Public origin, scheme included, no trailing slash.
PUBLIC_ORIGIN=https://francanglais.duckdns.org

# Shared registration code for collector accounts. Generate a strong one:
#   openssl rand -base64 24
# Leave EMPTY to disable self-service signup entirely (accounts are then created
# only with: docker compose exec api yaounde-analyzer provision-user <username>)
YAOUNDE_SIGNUP_CODE=

# Session lifetime in seconds (default 8 hours).
YAOUNDE_SESSION_SECONDS=28800
