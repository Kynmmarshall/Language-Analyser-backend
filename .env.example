# Copy to .env beside docker-compose.yml and fill in. Never commit .env.
# Compose reads this automatically -- no extra -f or --env-file flags needed.
#
#   cp .env.example .env && nano .env && docker compose up -d
#
# With no .env present, the defaults in docker-compose.yml give a working local
# dev container (loopback 8010, Vite dev-server origins, signup disabled).

# --- Required in a real deployment -----------------------------------------
# Browser origins allowed to sign in. Scheme included, no trailing slash.
# Getting this wrong is the usual cause of "403 Cross-origin request rejected".
YAOUNDE_CORS_ORIGINS=https://francanglais.duckdns.org

# Loopback port Nginx proxies to. Must match proxy_pass in
# deploy/nginx/francanglais.duckdns.org.conf.
API_HOST_PORT=2023

# --- Optional ---------------------------------------------------------------
# Shared registration code for self-service signup. Generate with:
#   openssl rand -base64 24
# Leave empty to disable signup and create accounts by hand instead:
#   docker compose exec api yaounde-analyzer provision-user <username>
YAOUNDE_SIGNUP_CODE=

# Session lifetime in seconds (default 8 hours).
YAOUNDE_SESSION_SECONDS=28800
